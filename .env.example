# Required
DATABASE_URL=postgres://user:pass@host/db   # Neon pooled URL in production; pglite://.data/dev locally
BASE_URL=https://opengallery.fly.dev
PORT=3000

# Email: one platform sender. Each message shows the Studio's name and replies go to its owner.
SMTP_URL=smtp://user:pass@smtp.example.com:587
# Or, for Resend, just the key (wins over SMTP_URL): RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@opengallery.app

# Photo storage (Cloudflare R2). All four, or none for local dev (memory storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opengallery-media

# NODE_ENV=production requires SMTP_URL (or RESEND_API_KEY) and all R2 variables, and refuses pglite.
