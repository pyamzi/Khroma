{
  "name": "opengallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && mkdir -p dist/server/db && cp -R src/server/db/migrations dist/server/db/ && vite build",
    "start": "node dist/server/index.js",
    "cli": "tsx src/server/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "npm run build && playwright test",
    "demo": "npm run build && tsx tests/e2e/demo.ts",
    "plugin:zip": "rm -f dist/OpenGallery.lrplugin.zip && mkdir -p dist && (cd plugin && zip -qr ../dist/OpenGallery.lrplugin.zip OpenGallery.lrplugin -x '*.DS_Store')"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "nodemailer": "^10.0.8",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
